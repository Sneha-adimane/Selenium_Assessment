package Assessments;

import java.awt.AWTException;
import java.awt.Robot;
import java.awt.event.KeyEvent;
import java.io.FileInputStream;
import java.io.IOException;
import java.time.Duration;
import java.util.Properties;

import org.apache.poi.ss.usermodel.Cell;
import org.apache.poi.ss.usermodel.Row;
import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.usermodel.WorkbookFactory;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.edge.EdgeDriver;

public class Day6_TestCase {

	public static void main(String[] args) throws IOException, InterruptedException, AWTException {
		//common data in properties file
		FileInputStream file = new FileInputStream("./src/test/resources/DDT/common_data_OHRM.properties");
		Properties p = new Properties();
		p.load(file);
		String browser = p.getProperty("browser");
		String url = p.getProperty("url");
		String un = p.getProperty("username");
		String pass = p.getProperty("password");
		//launch the browser
		WebDriver d = null;
		if(browser.equals("chrome"))
			d = new ChromeDriver();
		if(browser.equals("edge"))
			d = new EdgeDriver();
		//maximise the window
		d.manage().window().maximize();
		//implicit wait
		d.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		//navigate to the application
		d.get(url);
		Thread.sleep(2000);
		//login details
		d.findElement(By.name("username")).sendKeys(un);
		d.findElement(By.name("password")).sendKeys(pass);
		d.findElement(By.cssSelector("[class='oxd-button oxd-button--medium oxd-button--main orangehrm-login-button']")).click();
		//PIM Link
		d.findElement(By.xpath("//span[text()='PIM']")).click();
		Thread.sleep(2000);
		d.findElement(By.cssSelector("[class='oxd-button oxd-button--medium oxd-button--secondary']")).click();
		//data in xl sheet
		FileInputStream fis = new FileInputStream("src/test/resources/DDT/data_OHRM.xlsx");
		Workbook w = WorkbookFactory.create(fis);
		Sheet sh = w.getSheet("sheet1");
		Row row = sh.getRow(0);
		Cell cell = row.getCell(0);
		
		String fn = w.getSheet("sheet1").getRow(1).getCell(0).getStringCellValue();
		String mn = w.getSheet("sheet1").getRow(1).getCell(1).getStringCellValue();
		String ln = w.getSheet("sheet1").getRow(1).getCell(2).getStringCellValue();
		String EID = String.valueOf((long)w.getSheet("sheet1").getRow(1).getCell(3).getNumericCellValue());
		//Employee details
		d.findElement(By.name("firstName")).sendKeys(fn);
		d.findElement(By.name("middleName")).sendKeys(mn);
		d.findElement(By.name("lastName")).sendKeys(ln);
		d.findElement(By.xpath("(//input[@class='oxd-input oxd-input--active'])[2]")).sendKeys(EID);
		
		d.findElement(By.cssSelector("[class='oxd-switch-input oxd-switch-input--active --label-right']")).click();
		Thread.sleep(2000);
		String empUN = w.getSheet("sheet1").getRow(1).getCell(4).getStringCellValue();
		String empPW = w.getSheet("sheet1").getRow(1).getCell(5).getStringCellValue();
		String cPass = w.getSheet("sheet1").getRow(1).getCell(6).getStringCellValue();
		String eName = w.getSheet("sheet1").getRow(1).getCell(7).getStringCellValue();
		
		d.findElement(By.xpath("(//input[@class='oxd-input oxd-input--active'])[3]")).sendKeys(empUN);
		Thread.sleep(2000);
		d.findElement(By.xpath("(//input[@type='password'])[1]")).sendKeys(empPW);
		d.findElement(By.xpath("(//input[@type='password'])[2]")).sendKeys(cPass);
		d.findElement(By.cssSelector("[class='oxd-button oxd-button--medium oxd-button--secondary orangehrm-left-space']")).click();
		Thread.sleep(2000);
		//admin link
		d.findElement(By.xpath("//span[normalize-space()=\"Admin\"]")).click();
		//username
		d.findElement(By.xpath("(//input[@class=\"oxd-input oxd-input--active\"])[2]")).sendKeys(empUN);
					
		Robot r = new Robot();
//		//select userrole to ess
		d.findElement(By.xpath("(//i[@class=\"oxd-icon bi-caret-down-fill oxd-select-text--arrow\"])[1]")).click();
		r.keyPress(KeyEvent.VK_DOWN);
		r.keyRelease(KeyEvent.VK_DOWN);
		r.keyPress(KeyEvent.VK_DOWN);
		r.keyRelease(KeyEvent.VK_DOWN);
		r.keyPress(KeyEvent.VK_ENTER);
		r.keyRelease(KeyEvent.VK_ENTER);

		//select employee name
		d.findElement(By.xpath("//input[@placeholder=\"Type for hints...\"]")).sendKeys(eName);
		Thread.sleep(5000);
		
		r.keyPress(KeyEvent.VK_DOWN);
		r.keyRelease(KeyEvent.VK_DOWN);
		r.keyPress(KeyEvent.VK_ENTER);
		r.keyRelease(KeyEvent.VK_ENTER);
		Thread.sleep(3000);
		//Select status
		d.findElement(By.xpath("(//i[@class=\"oxd-icon bi-caret-down-fill oxd-select-text--arrow\"])[2]")).click();
		r.keyPress(KeyEvent.VK_DOWN);
		r.keyRelease(KeyEvent.VK_DOWN);
		r.keyPress(KeyEvent.VK_ENTER);
		r.keyRelease(KeyEvent.VK_ENTER);
		//click on submit
		Thread.sleep(3000);
		d.findElement(By.xpath("//button[@type='submit']")).click();
		
		// Validation
		if(d.findElement(By.xpath("//div[@class=\"oxd-table-cell oxd-padding-cell\"]/child::div[contains(.,\"Sneha123\")]")).isDisplayed()) {
			System.out.println("Record is displayed");
		}else {
			
			System.out.println("Record is NOT displayed");
		}
		
		
		
		Thread.sleep(5000);
		d.quit();
	}
}
