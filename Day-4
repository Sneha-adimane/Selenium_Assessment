package demo;

import java.time.Duration;
import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class text_filed_size_ {

	public static void main(String[] args) throws InterruptedException {
		WebDriver d = new ChromeDriver();
		d.manage().window().maximize();
		d.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		d.get("https://www.facebook.com/");
		Thread.sleep(2000);
		List<WebElement> tf = d.findElements(By.tagName("input"));
		int count = tf.size();
		System.out.println(count);
		for(WebElement ele: tf)
		{
			System.out.println(ele.getAccessibleName());
			if(ele.getAccessibleName().equals("Email address or mobile number"))
				ele.sendKeys("Sneha");
			else
				ele.sendKeys("Sneha@123");
		}
		d.quit();
		
	}
}


Testcase-02 //zomato login

package demo;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class zomato {

	public static void main(String[] args) throws InterruptedException {
		WebDriver d = new ChromeDriver();
		d.manage().window().maximize();
		d.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		d.get("https://www.zomato.com/bangalore/delivery");
		Thread.sleep(2000);
		d.findElement(By.xpath("//button[text()='Log in']")).click();
		Thread.sleep(2000);
		WebElement id = d.findElement(By.id("auth-login-ui"));
		d.switchTo().frame(id);
		d.findElement(By.xpath("//input[@type='number']")).sendKeys("9663883349");
		d.switchTo().defaultContent();
		Thread.sleep(2000);
		String text = d.findElement(By.xpath("//div[text()='Delivery']")).getText();
		if(text.equals("Delivery"))
			System.out.println("I am in main page");
		else
			System.out.println("I am in frame page");
	}
}


